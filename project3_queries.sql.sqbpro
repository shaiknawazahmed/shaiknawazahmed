<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="SQL_Project_3.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2351"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="CAMPAIGNS" custom_title="0" dock_id="1" table="4,9:mainCAMPAIGNS"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- ============================================
-- SQL PROJECT 3
-- Business &amp; Marketing Sales Analysis
-- ============================================


-- 1. Total Sales

SELECT SUM(SALES_AMOUNT) AS TOTAL_SALES
FROM SALES;


-- 2. Average Sale

SELECT AVG(SALES_AMOUNT) AS AVERAGE_SALE
FROM SALES;


-- 3. Highest Sale

SELECT MAX(SALES_AMOUNT) AS HIGHEST_SALE
FROM SALES;


-- 4. Lowest Sale

SELECT MIN(SALES_AMOUNT) AS LOWEST_SALE
FROM SALES;


-- 5. Total Number of Sales Transactions

SELECT COUNT(*) AS TOTAL_SALES_TRANSACTIONS
FROM SALES;


-- 6. Total Quantity Sold

SELECT SUM(QUANTITY) AS TOTAL_QUANTITY
FROM SALES;


-- 7. Product-wise Sales

SELECT
    P.PRODUCT_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
GROUP BY P.PRODUCT_NAME
ORDER BY TOTAL_SALES DESC;


-- 8. Category-wise Sales

SELECT
    P.CATEGORY,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
GROUP BY P.CATEGORY
ORDER BY TOTAL_SALES DESC;


-- 9. Customer-wise Sales

SELECT
    C.CUSTOMER_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
GROUP BY C.CUSTOMER_NAME
ORDER BY TOTAL_SALES DESC;


-- 10. City-wise Sales

SELECT
    C.CITY,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
GROUP BY C.CITY
ORDER BY TOTAL_SALES DESC;


-- 11. Customer Type-wise Sales

SELECT
    C.CUSTOMER_TYPE,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
GROUP BY C.CUSTOMER_TYPE
ORDER BY TOTAL_SALES DESC;


-- 12. Campaign-wise Sales

SELECT
    C.CAMPAIGN_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CAMPAIGNS C
ON S.CAMPAIGN_ID = C.CAMPAIGN_ID
GROUP BY C.CAMPAIGN_NAME
ORDER BY TOTAL_SALES DESC;


-- 13. Channel-wise Sales

SELECT
    C.CHANNEL,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CAMPAIGNS C
ON S.CAMPAIGN_ID = C.CAMPAIGN_ID
GROUP BY C.CHANNEL
ORDER BY TOTAL_SALES DESC;


-- 14. Campaign Budget vs Sales

SELECT
    C.CAMPAIGN_NAME,
    C.BUDGET,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM CAMPAIGNS C
JOIN SALES S
ON C.CAMPAIGN_ID = S.CAMPAIGN_ID
GROUP BY C.CAMPAIGN_NAME, C.BUDGET
ORDER BY TOTAL_SALES DESC;


-- 15. Top Customer

SELECT
    C.CUSTOMER_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
GROUP BY C.CUSTOMER_NAME
ORDER BY TOTAL_SALES DESC
LIMIT 1;


-- 16. Top Product

SELECT
    P.PRODUCT_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
GROUP BY P.PRODUCT_NAME
ORDER BY TOTAL_SALES DESC
LIMIT 1;


-- 17. Top Campaign

SELECT
    C.CAMPAIGN_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CAMPAIGNS C
ON S.CAMPAIGN_ID = C.CAMPAIGN_ID
GROUP BY C.CAMPAIGN_NAME
ORDER BY TOTAL_SALES DESC
LIMIT 1;


-- 18. Sales Above 30,000

SELECT *
FROM SALES
WHERE SALES_AMOUNT &gt; 30000
ORDER BY SALES_AMOUNT DESC;


-- 19. Customers with Sales Above 50,000

SELECT
    C.CUSTOMER_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
GROUP BY C.CUSTOMER_NAME
HAVING SUM(S.SALES_AMOUNT) &gt; 50000
ORDER BY TOTAL_SALES DESC;


-- 20. Products with Sales Above 50,000

SELECT
    P.PRODUCT_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
GROUP BY P.PRODUCT_NAME
HAVING SUM(S.SALES_AMOUNT) &gt; 50000
ORDER BY TOTAL_SALES DESC;


-- 21. Monthly Sales

SELECT
    strftime('%Y-%m', SALE_DATE) AS MONTH,
    SUM(SALES_AMOUNT) AS TOTAL_SALES
FROM SALES
GROUP BY MONTH
ORDER BY MONTH;


-- 22. Monthly Transaction Count

SELECT
    strftime('%Y-%m', SALE_DATE) AS MONTH,
    COUNT(*) AS TOTAL_TRANSACTIONS
FROM SALES
GROUP BY MONTH
ORDER BY MONTH;


-- 23. Premium Customer Sales

SELECT
    C.CUSTOMER_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
WHERE C.CUSTOMER_TYPE = 'Premium'
GROUP BY C.CUSTOMER_NAME
ORDER BY TOTAL_SALES DESC;


-- 24. Electronics Sales

SELECT
    SUM(S.SALES_AMOUNT) AS ELECTRONICS_SALES
FROM SALES S
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
WHERE P.CATEGORY = 'Electronics';


-- 25. Furniture Sales

SELECT
    SUM(S.SALES_AMOUNT) AS FURNITURE_SALES
FROM SALES S
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
WHERE P.CATEGORY = 'Furniture';


-- 26. Top 3 Products

SELECT
    P.PRODUCT_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
GROUP BY P.PRODUCT_NAME
ORDER BY TOTAL_SALES DESC
LIMIT 3;


-- 27. Top 3 Customers

SELECT
    C.CUSTOMER_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
GROUP BY C.CUSTOMER_NAME
ORDER BY TOTAL_SALES DESC
LIMIT 3;


-- 28. Campaigns with Sales Above 50,000

SELECT
    C.CAMPAIGN_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CAMPAIGNS C
ON S.CAMPAIGN_ID = C.CAMPAIGN_ID
GROUP BY C.CAMPAIGN_NAME
HAVING SUM(S.SALES_AMOUNT) &gt; 50000
ORDER BY TOTAL_SALES DESC;


-- 29. Sales by Customer and Product

SELECT
    C.CUSTOMER_NAME,
    P.PRODUCT_NAME,
    SUM(S.SALES_AMOUNT) AS TOTAL_SALES
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
GROUP BY C.CUSTOMER_NAME, P.PRODUCT_NAME
ORDER BY TOTAL_SALES DESC;


-- 30. Complete Business Sales Analysis

SELECT
    C.CUSTOMER_NAME,
    C.CITY,
    C.CUSTOMER_TYPE,
    P.PRODUCT_NAME,
    P.CATEGORY,
    M.CAMPAIGN_NAME,
    M.CHANNEL,
    S.QUANTITY,
    S.SALES_AMOUNT,
    S.SALE_DATE
FROM SALES S
JOIN CUSTOMERS C
ON S.CUSTOMER_ID = C.CUSTOMER_ID
JOIN PRODUCTS P
ON S.PRODUCT_ID = P.PRODUCT_ID
JOIN CAMPAIGNS M
ON S.CAMPAIGN_ID = M.CAMPAIGN_ID
ORDER BY S.SALES_AMOUNT DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
