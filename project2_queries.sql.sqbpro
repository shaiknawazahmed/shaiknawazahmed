<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="SQL 2.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="809"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="DEPARTMENTS" custom_title="0" dock_id="1" table="4,11:mainDEPARTMENTS"/><dock_state state="000000ff00000000fd00000001000000020000043c000002b6fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000043c0000011800ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="DEPARTMENTS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="85"/><column index="2" value="54"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- SQL PROJECT 2: EMPLOYEE PERFORMANCE ANALYSIS

-- 1. Total Sales
SELECT SUM(SALES) AS TOTAL_SALES
FROM PERFORMANCE;

-- 2. Average Sales
SELECT AVG(SALES) AS AVERAGE_SALES
FROM PERFORMANCE;

-- 3. Highest Sale
SELECT MAX(SALES) AS HIGHEST_SALE
FROM PERFORMANCE;

-- 4. Lowest Sale
SELECT MIN(SALES) AS LOWEST_SALE
FROM PERFORMANCE;

-- 5. Total Performance Records
SELECT COUNT(*) AS TOTAL_RECORDS
FROM PERFORMANCE;

-- 6. Employee-wise Total Sales
SELECT E.NAME, SUM(P.SALES) AS TOTAL_SALES
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.NAME;

-- 7. Department-wise Total Sales
SELECT E.DEPARTMENT, SUM(P.SALES) AS TOTAL_SALES
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.DEPARTMENT;

-- 8. Department-wise Average Rating
SELECT E.DEPARTMENT, AVG(P.RATING) AS AVERAGE_RATING
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.DEPARTMENT;

-- 9. January Sales
SELECT SUM(SALES) AS JANUARY_SALES
FROM PERFORMANCE
WHERE MONTH = 'January';

-- 10. February Sales
SELECT SUM(SALES) AS FEBRUARY_SALES
FROM PERFORMANCE
WHERE MONTH = 'February';

-- 11. Sales Above 50,000
SELECT *
FROM PERFORMANCE
WHERE SALES &gt; 50000
ORDER BY SALES DESC;

-- 12. Employees with Total Sales Above 90,000
SELECT E.NAME, SUM(P.SALES) AS TOTAL_SALES
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.NAME
HAVING SUM(P.SALES) &gt; 90000;

-- 13. Employee + Department + Sales
SELECT E.NAME, E.DEPARTMENT, P.MONTH, P.SALES, P.RATING
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID;

-- 14. Top Employee
SELECT E.NAME, SUM(P.SALES) AS TOTAL_SALES
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.NAME
ORDER BY TOTAL_SALES DESC
LIMIT 1;

-- 15. Top Department
SELECT E.DEPARTMENT, SUM(P.SALES) AS TOTAL_SALES
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.DEPARTMENT
ORDER BY TOTAL_SALES DESC
LIMIT 1;

-- 16. Highest Rated Employee
SELECT E.NAME, AVG(P.RATING) AS AVERAGE_RATING
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.NAME
ORDER BY AVERAGE_RATING DESC
LIMIT 1;

-- 17. City-wise Sales
SELECT E.CITY, SUM(P.SALES) AS TOTAL_SALES
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.CITY
ORDER BY TOTAL_SALES DESC;

-- 18. Department Sales vs Target
SELECT E.DEPARTMENT, SUM(P.SALES) AS TOTAL_SALES, D.TARGET
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
JOIN DEPARTMENTS D ON E.DEPARTMENT = D.DEPARTMENT
GROUP BY E.DEPARTMENT, D.TARGET;

-- 19. Employees with Rating 5
SELECT E.NAME, P.MONTH, P.RATING
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
WHERE P.RATING = 5;

-- 20. Top 3 Employees by Total Sales
SELECT E.NAME, SUM(P.SALES) AS TOTAL_SALES
FROM PERFORMANCE P
JOIN EMPLOYEES E ON P.EMPLOYEE_ID = E.EMPLOYEE_ID
GROUP BY E.NAME
ORDER BY TOTAL_SALES DESC
LIMIT 3;</sql><current_tab id="0"/></tab_sql></sqlb_project>
